ENVIRONMENT=development
LOG_LEVEL=INFO

SECRET_KEY=change-this-local-secret
JWT_SECRET=change-this-local-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SQLITE_DATABASE_URL=sqlite:///./eduedge.db
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eduedge

# Local summarize development does not require PostgreSQL.
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=30

AI_ENGINE_BASE_URL=http://127.0.0.1:8001
